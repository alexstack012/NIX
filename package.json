{
  "name": "nix-local-agent",
  "version": "0.1.0",
  "description": "A local-first AI coding agent for Windows and other development workstations.",
  "type": "module",
  "private": true,
  "bin": {
    "nix-agent": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "fixture:create": "tsx src/dev/fixture-cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node dist/cli/index.js",
    "test": "vitest run tests",
    "test:watch": "vitest tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
